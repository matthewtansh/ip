<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT" maxWidth="1.7976931348623157E308"
         spacing="6.0" type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="4.0" left="8.0" right="8.0" top="4.0" />
    </padding>
    <children>
        <Label fx:id="messageLabel" maxWidth="410.0" minHeight="-Infinity"
               styleClass="dialog-message" wrapText="true" />
        <Label fx:id="speakerLabel" alignment="CENTER" minWidth="44.0"
               styleClass="speaker-label" />
    </children>
</fx:root>
