<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="540.0"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ollie.MainWindow">
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="6.0"
                      styleClass="dialog-container" />
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox spacing="8.0" styleClass="input-bar">
            <padding>
                <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
            </padding>
            <TextField fx:id="userInput" HBox.hgrow="ALWAYS"
                       onAction="#handleUserInput"
                       promptText="Enter a command..." />
            <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput"
                    prefWidth="72.0" text="Send" />
        </HBox>
    </bottom>
</BorderPane>
